# Copy this file to .env and fill in real values before deploying anywhere
# beyond local development. Nothing in this file is a real credential.

# --- Backend API (apps/api) ---------------------------------------------

ENVIRONMENT=development
DEBUG=true

# Postgres in production/staging; SQLite (default, no setup needed) in dev.
DATABASE_URL=postgresql+asyncpg://datalume:datalume@localhost:5432/datalume

REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage for uploaded datasets. Local dev can point
# at the MinIO container started by infra/docker-compose.yml.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=datalume-uploads
S3_ACCESS_KEY=datalume
S3_SECRET_KEY=datalume-dev-only
S3_REGION=eu-west-2
LOCAL_STORAGE_DIR=./var/uploads

# Absolute upload safety ceiling in bytes — must stay >= the largest
# plan's limit (Enterprise: 1GB, see app/core/plans.py) or that plan's
# uploads get rejected here before the per-plan check in billing.py runs.
MAX_UPLOAD_SIZE_BYTES=1073741824
# No real malware scanner is wired in yet — see docs/SECURITY.md. Leave
# false until one is integrated; this flag does not currently do anything
# on its own, it exists so the gap is visible in config rather than silent.
MALWARE_SCANNING_ENABLED=false

# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_DEV_ONLY_INSECURE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# Stripe billing (app/services/stripe_billing.py). Entitlements, quota
# enforcement and webhook *handling* are all built and tested — but
# Checkout/Portal session creation needs a real test-mode account to
# actually exercise. Get these from the Dashboard / CLI:
#   https://dashboard.stripe.com/test/apikeys  (secret key)
#   https://dashboard.stripe.com/test/webhooks (webhook signing secret,
#     after adding an endpoint pointing at POST /api/v1/billing/webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Once you've created Products/Prices in the Stripe Dashboard (test mode)
# for each paid plan, set the resulting price IDs here — one pair per
# plan_id in app/core/plans.py. Until set, those plans show as
# "not yet purchasable" on the pricing page (self_serve: false) and
# /billing/checkout-session returns a clear 400 for them.
STRIPE_PRICE_ID_PERSONAL_MONTHLY=
STRIPE_PRICE_ID_PERSONAL_ANNUAL=
STRIPE_PRICE_ID_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_ID_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_ID_BUSINESS_MONTHLY=
STRIPE_PRICE_ID_BUSINESS_ANNUAL=
STRIPE_PRICE_ID_TEAM_MONTHLY=
STRIPE_PRICE_ID_TEAM_ANNUAL=

# Where Stripe Checkout/Billing Portal redirect back to after use.
FRONTEND_BASE_URL=http://localhost:3000

# LLM provider for the AI data analyst (app/services/ai/). The planner,
# grounding, tool-calling loop and conversation storage are all built and
# tested — but only with a scripted fake client. Set a real key here
# (an Anthropic API key, from https://console.anthropic.com/) to actually
# exercise AnthropicLLMClient for the first time. Without it, /ask
# correctly returns 503 rather than a fake answer.
LLM_PROVIDER=anthropic
LLM_API_KEY=

CORS_ORIGINS=["http://localhost:3000"]

# Enterprise SSO (app/services/sso.py). Account-linking logic and the
# cryptographic token-validation path are tested end-to-end against a
# self-controlled fake OIDC provider — but this has NEVER been run
# against a real identity provider (Okta/Azure AD/Google Workspace).
# Without these set, /sso/login and /sso/callback return a clear 503.
# Point OIDC_DISCOVERY_URL at your IdP's
# `.well-known/openid-configuration` document.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_REDIRECT_URI=http://localhost:3000/sso/callback

# Transactional email (app/services/email.py). Blocks three otherwise-
# finished features until set: email verification, password reset, and
# organization invites to not-yet-registered users. Works with any
# standard SMTP provider — Postmark, SendGrid's SMTP endpoint, AWS SES
# SMTP, Gmail, or your own server. Without SMTP_HOST, registration still
# succeeds (just unverified, as before this feature existed), but
# /auth/forgot-password, /auth/resend-verification, and inviting an
# email with no account all correctly return 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@datalume.example
SMTP_USE_TLS=true

# --- Frontend (apps/web) -------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:8000
